# Diretório no HD/SSD do servidor onde tudo fica persistido (arquivos reais, banco e backups)
# Exemplo em produção num HD dedicado: DATA_DIR=/mnt/hd-dados/personal-drive
DATA_DIR=./data

# UID/GID do seu usuário no Linux (rode `id -u` e `id -g`) para que as pastas/arquivos pertençam a você
PUID=1000
PGID=1000

# Porta HTTP principal da aplicação (Front-End + Proxy da API)
APP_PORT=5174

# Portas locais opcionais para depuração/desenvolvimento
BACKEND_PORT=5001
POSTGRES_PORT=5433

# Credenciais do PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=suasenha
POSTGRES_DB=personal_drive

# Limite de upload (MB) e dias na lixeira
MAX_UPLOAD_MB=1024
TRASH_TTL_DAYS=30

# Rotina automática de backup do banco
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
