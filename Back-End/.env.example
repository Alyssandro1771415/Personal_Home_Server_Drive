# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=5001

# Diretório real de pastas e arquivos no disco (default: Back-End/storage)
STORAGE_ROOT=storage

# Limite máximo por upload em MB
MAX_UPLOAD_MB=1024

# Lixeira: dias até exclusão definitiva
TRASH_TTL_DAYS=30

# Postgres
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=personal_drive
DATABASE_USER=postgres
DATABASE_PASSWORD=suasenha
